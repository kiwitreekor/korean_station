##grflangid 0x01

# GRF name and description
STR_GRF_NAME								:Korean Station Set v2.0-alpha
STR_GRF_DESC								:{WHITE}This newgrf provides Korean style station tiles.{}{}{BLACK}Special thanks:{}{GREEN}  Las{}  EightonEight{}  Gamunbi{}  Chojeohang{}{}{BLACK} copyright 2017 - 2025 {LTBLUE}kiwitree
STR_GRF_URL									:https://github.com/kiwitreekor/korean_station

STR_PARAM_MODE_NAME							:Mode
STR_PARAM_MODE_DESC							:Normal: Disable compatibility mode and enable all available station tiles.{}High platforms only: Enable only high platforms and disable the others.
STR_PARAM_MODE_LIST_NORMAL					:Normal
STR_PARAM_MODE_LIST_HIGHPLATFORMS			:High platforms only

STR_PARAM_PSDSFX_NAME						:Play sound effects when screendoor closes or opens
STR_PARAM_PSDSFX_DESC						:If you set this setting on, it will make sound when screendoor closes or opens.

STR_PARAM_PASSENGER_NAME					:Show passenger graphics by waiting amount
STR_PARAM_PASSENGER_DESC					:If you set this setting on, it will show passenger graphics by waiting amount.

STR_PARAM_SHADOW_NAME						:Make shadow under roof
STR_PARAM_SHADOW_DESC						:If you set this setting on, platform under roof will shown dark.

STR_PARAM_SNOW_NAME							:Enable snow graphics
STR_PARAM_SNOW_DESC							:If you set this setting on, platform above snowline will covered with snow. Disable if graphical gliches occur.

STR_PARAM_FENCE_NAME						:Enable fence graphics
STR_PARAM_FENCE_DESC						:If you set this setting on, it will show fence graphics on the both sides of station.

STR_PARAM_DEPOT_GATE_NAME					:Make depot gate always open
STR_PARAM_DEPOT_GATE_DESC					:If you set this setting on, depot gate will be always opened.

STR_PARAM_CATENARY_NAME						:Catenary graphics
STR_PARAM_CATENARY_DESC						:None: Disable pylon graphics {}Type A: Korean style pylon graphic {}Type B: OpenTTD style pylon graphic

STR_PARAM_CATENARY_NONE						:None
STR_PARAM_CATENARY_TYPE_A					:Type A (Default)
STR_PARAM_CATENARY_TYPE_B					:Type B

STR_PARAM_BRIDGE_NAME						:Allow stations under bridges
STR_PARAM_BRIDGE_DESC						:Allow stations to be built under bridges. {}{}{RED}Caution!  {WHITE}It works properly only on JGRPP v0.26.0 or later.

STR_PARAM_ROOF_COLOUR_NAME					:Roof colour
STR_PARAM_ROOF_COLOUR_DESC					:Select the colour of the roofs.

STR_PARAM_ROOF_COLOUR_CC					:Use Company Colour
STR_PARAM_ROOF_COLOUR_DBLUE					:Dark blue
STR_PARAM_ROOF_COLOUR_PGREEN				:Pale green
STR_PARAM_ROOF_COLOUR_PINK					:Pink
STR_PARAM_ROOF_COLOUR_YELLOW				:Yellow
STR_PARAM_ROOF_COLOUR_RED					:Red
STR_PARAM_ROOF_COLOUR_LTBLUE				:Light blue
STR_PARAM_ROOF_COLOUR_GREEN					:Green
STR_PARAM_ROOF_COLOUR_DGREEN				:Dark green
STR_PARAM_ROOF_COLOUR_BLUE					:Blue (Default)
STR_PARAM_ROOF_COLOUR_CREAM					:Cream
STR_PARAM_ROOF_COLOUR_MAUVE					:Mauve
STR_PARAM_ROOF_COLOUR_PURPLE				:Purple
STR_PARAM_ROOF_COLOUR_ORANGE				:Orange
STR_PARAM_ROOF_COLOUR_BROWN					:Brown
STR_PARAM_ROOF_COLOUR_GREY					:Grey
STR_PARAM_ROOF_COLOUR_WHITE					:White

STR_PARAM_SIGNAL_SIDE_NAME					:Show signals
STR_PARAM_SIGNAL_SIDE_DESC					:Select on which side of the track to place signals.

STR_PARAM_SIGNAL_SIDE_LEFT					:On the left
STR_PARAM_SIGNAL_SIDE_DRIVING				:On the driving side
STR_PARAM_SIGNAL_SIDE_RIGHT					:On the right

