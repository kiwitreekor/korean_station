{%include 'layouts/building_platforms.pnml' %}

switch(FEAT_STATIONS, SELF, sw_hide_building_poleA, [STORE_TEMP(0, 126), STORE_TEMP(-1, 127), sw_building_nearby_info()]) {
	1 .. 2: return 1;
    return 0;
}

switch(FEAT_STATIONS, SELF, sw_hide_building_poleB, [STORE_TEMP(0, 126), STORE_TEMP(1, 127), sw_building_nearby_info()]) {
	1 .. 2: return 1;
    return 0;
}

switch(FEAT_STATIONS, SELF, sw_hide_building_catenary, param_catenary) {
	0: return 1;
    return 0;
}

switch(FEAT_STATIONS, SELF, sw_prepare_building_platform, [
	STORE_TEMP(sw_company_color(), 4), 
	STORE_TEMP(sw_terrain_snow() * spr_building_snow_offset, 5), 
	STORE_TEMP(sw_hide_building_poleA(), 6), 
	STORE_TEMP(sw_hide_building_poleB(), 7), 
	STORE_TEMP(sw_hide_building_catenary(), 8), 
	STORE_TEMP(platform_number_from_start(PLATFORM_SAME_STATION) % 2, 9), 
]) {
	sw_prepare_platform;
}

switch(FEAT_STATIONS, SELF, sw_purchase_prepare_building_platform, [
	STORE_TEMP(sw_company_color(), 4), 
	STORE_TEMP(0, 5), 
	STORE_TEMP(0, 6), 
	STORE_TEMP(0, 7), 
	STORE_TEMP(0, 8), 
	STORE_TEMP(platform_number_from_start(PLATFORM_SAME_STATION) % 2, 9), 
]) {
	sw_prepare_platform;
}

{% macro item_modular_properties(x, string_code, custom_spritesets = "") -%}
	property {
		class: "KWS2";
		name: string({{ string_code }});
		cargo_random_triggers: [PASS];
        hide_wire_tiles: STAT_ALL_TILES;
        draw_pylon_tiles: 0;
	}
	graphics {
        default: sprgroup_platform;
        purchase: sprgroup_platform;
        sprite_layouts: [
            layout_{{ x }}_X, 
            layout_{{ x }}_Y,
        ];
        {% if custom_spritesets -%}
            custom_spritesets: {{ custom_spritesets }};
        {%- endif %}
        select_sprite_layout: sw_overpass_layout();
		prepare_layout: sw_prepare_building_platform();
		purchase_prepare_layout: sw_purchase_prepare_building_platform();
	}
{%- endmacro %}

item(FEAT_STATIONS, item_high_platformA_modular_low, 0x32) {
	{{ item_modular_properties("high_platformA_modular_low", "STR_STATION_MODULAR_LOW_HP_A", "[sprset_building]")}}
}

