    return MODULAR_TILE_S;
}

switch(FEAT_STATIONS, SELF, sw_building_layout_single_sub2_2_2, rail_present & 0x3) {
    1: sw_building_layout_single_sub2_2_2_1;
    return MODULAR_TILE_E;
}

switch(FEAT_STATIONS, SELF, sw_building_layout_single_sub2_2, [STORE_TEMP(1, 126), STORE_TEMP(0, 127), sw_building_nearby_info()]) {
    1 .. 2: sw_building_layout_single_sub2_2_1;
    sw_building_layout_single_sub2_2_2;
}

switch(FEAT_STATIONS, SELF, sw_building_layout_single_sub2_1_1, [STORE_TEMP(-1, 126), STORE_TEMP(1, 127), sw_building_nearby_info()]) {
    1 .. 2: return MODULAR_TILE_FULL;
    return MODULAR_TILE_NWS;
}

