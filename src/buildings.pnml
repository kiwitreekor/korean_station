{% include 'layouts/buildings.pnml' %}

const MODULAR_TILE_NW   = 0;
const MODULAR_TILE_SE   = 1;
const MODULAR_TILE_N    = 2;
const MODULAR_TILE_E    = 3;
const MODULAR_TILE_S    = 4;
const MODULAR_TILE_W    = 5;
const MODULAR_TILE_NWE  = 6;
const MODULAR_TILE_NES  = 7;
const MODULAR_TILE_SWE  = 8;
const MODULAR_TILE_NWS  = 9;
const MODULAR_TILE_FULL = 10;

// sw_building_layout_single_sub3
switch(FEAT_STATIONS, SELF, sw_building_layout_single_sub3_1, [STORE_TEMP(-1, 126), STORE_TEMP(-1, 127), sw_building_nearby_info()]) {
    1 .. 2: return MODULAR_TILE_NES;
    return MODULAR_TILE_SWE;
}

switch(FEAT_STATIONS, SELF, sw_building_layout_single_sub3_2, rail_present & 0x3) {
    1: return MODULAR_TILE_S;
    2: return MODULAR_TILE_E;
    return MODULAR_TILE_SE;
}

switch(FEAT_STATIONS, SELF, sw_building_layout_single_sub3, [STORE_TEMP(0, 126), STORE_TEMP(-1, 127), sw_building_nearby_info()]) {
    1: return MODULAR_TILE_FULL;
    2: sw_building_layout_single_sub3_1;
    sw_building_layout_single_sub3_2;
}

// sw_building_layout_single_sub2
switch(FEAT_STATIONS, SELF, sw_building_layout_single_sub2_2_1_1, [STORE_TEMP(1, 126), STORE_TEMP(1, 127), sw_building_nearby_info()]) {
    1 .. 2: return MODULAR_TILE_SE;
    return MODULAR_TILE_NWE;
}

switch(FEAT_STATIONS, SELF, sw_building_layout_single_sub2_2_1_2_1, rail_present & 0x3) {
    2: return MODULAR_TILE_SE;
    return MODULAR_TILE_S;
}

