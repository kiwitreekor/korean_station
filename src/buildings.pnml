    1 .. 2: return MODULAR_TILE_NW;
    return MODULAR_TILE_W;
}

switch(FEAT_STATIONS, SELF, sw_building_layout_single_sub1_1_3, rail_present & 0x3) {
    1: sw_building_layout_single_sub1_1_3_1;
    return MODULAR_TILE_N;
}

switch(FEAT_STATIONS, SELF, sw_building_layout_single_sub1_1, [STORE_TEMP(1, 126), STORE_TEMP(0, 127), sw_building_nearby_info()]) {
    1: sw_building_layout_single_sub1_1_1;
    2: sw_building_layout_single_sub1_1_2;
    sw_building_layout_single_sub1_1_3;
}

switch(FEAT_STATIONS, SELF, sw_building_layout_single_sub1_2, rail_present & 0x3) {
    1: return MODULAR_TILE_W;
    2: return MODULAR_TILE_N;
    return MODULAR_TILE_NW;
}

switch(FEAT_STATIONS, SELF, sw_building_layout_single_sub1, [STORE_TEMP(0, 126), STORE_TEMP(-1, 127), sw_building_nearby_info()]) {
    2: sw_building_layout_single_sub1_1;
    sw_building_layout_single_sub1_2;
}

switch(FEAT_STATIONS, SELF, sw_building_layout_single, [STORE_TEMP(0, 126), STORE_TEMP(1, 127), sw_building_nearby_info()]) {
    1: sw_building_layout_single_sub3;
    2: sw_building_layout_single_sub2;
    sw_building_layout_single_sub1;
}

// sw_building_layout_front
switch(FEAT_STATIONS, SELF, sw_building_layout_front_sub2, [STORE_TEMP(-1, 126), STORE_TEMP(1, 127), sw_building_nearby_info()]) {
    1 .. 2: return MODULAR_TILE_FULL;
    return MODULAR_TILE_NWS;
}

