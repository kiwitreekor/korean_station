{%include 'layouts/crossings.pnml' %}


switch(FEAT_STATIONS, SELF, sw_crossing_offset_from_end, platform_position_from_end(PLATFORM_SAME_STATION)) {
	0: return 4;
	return 0;
}

switch(FEAT_STATIONS, SELF, sw_crossing_offset_from_start, platform_position_from_start(PLATFORM_SAME_STATION)) {
	0: return 8;
	sw_crossing_offset_from_end;
}

switch(FEAT_STATIONS, SELF, sw_crossing_offset, platform_length(PLATFORM_SAME_STATION)) {
	1: return 0;
	sw_crossing_offset_from_start;
}


switch(FEAT_STATIONS, SELF, sw_crossing_xoffset_from_end, platform_position_from_end(PLATFORM_SAME_STATION)) {
	0: return 13;
	return 7;
}

switch(FEAT_STATIONS, SELF, sw_crossing_xoffset_from_start, platform_position_from_start(PLATFORM_SAME_STATION)) {
	0: return 0;
	sw_crossing_xoffset_from_end;
}

switch(FEAT_STATIONS, SELF, sw_crossing_xoffset, platform_length(PLATFORM_SAME_STATION)) {
	1: return 7;
	sw_crossing_xoffset_from_start;
}

switch(FEAT_STATIONS, SELF, sw_prepare_crossings, [
	STORE_TEMP(sw_crossing_offset(), 4),
	STORE_TEMP(sw_crossing_xoffset(), 5),
]) {
	sw_prepare_platform;
}

{% macro item_crossings_properties(x, string_code, custom_spritesets = "") -%}
	property {
		class: "KWS1";
		name: string({{ string_code }});
		classname: string(STR_STATION_CLASS_CROSSING);
		cargo_random_triggers: [PASS];
	}
	graphics {
        default: sprgroup_platform;
        purchase: sprgroup_platform;
        sprite_layouts: [
            layout_{{ x }}_X, 
            layout_{{ x }}_Y,
        ];
        {% if custom_spritesets -%}
            custom_spritesets: {{ custom_spritesets }};
        {%- endif %}
		prepare_layout: sw_prepare_crossings();
	}
{%- endmacro %}

item(FEAT_STATIONS, item_high_platformA_crossings, 0x100) {
	{{ item_crossings_properties("high_platformA_crossings", "STR_STATION_CROSSING_HP_A") }}
}

