{% import 'layouts/layouts.pnml' as layouts %}
{% import 'layouts/platforms.pnml' as platforms %}

{% macro building_modular_station_overpass(orientation, offset, h) -%}
	{{ layouts.building_auto_orient(orientation, "CUSTOM(0, spr_building_overpass + {} + LOAD_TEMP(5))".format(offset),
		0,  0, 12, 16, 16, h-12, palette = "PALETTE_CC_DARK_BLUE + LOAD_TEMP(4)") }}
{%- endmacro %}

{% macro building_modular_station_pole(orientation, y, h) -%}
    {%- if h == 3 -%}
        {%- set offset = 0 -%}
    {%- elif h == 1 -%}
        {%- set offset = 2 -%}
    {%- else -%}
        {%- set offset = 4 -%}
    {%- endif -%}
	{{ layouts.building_auto_orient(orientation, "CUSTOM(0, spr_building_pole + {})".format(offset),
		0, y*16, h, 16, 0, 12-h, hide_sprite = "LOAD_TEMP({})".format(6 + y)) }}
{%- endmacro %}

{% macro building_modular_station_catenaryA(orientation) -%}
	{{ layouts.building_auto_orient(orientation, "CUSTOM(0, spr_building_catenary)",
		16, 6, 10,  0,  4,  2, hide_sprite = "LOAD_TEMP(8)") }}
{%- endmacro %}

{% macro building_modular_station_catenaryB(orientation) -%}
	{{ layouts.building_auto_orient(orientation, "CUSTOM(0, spr_building_catenary + 2)",
		16, 6, 10,  0,  4,  2, hide_sprite = "LOAD_TEMP(8)") }}
{%- endmacro %}

{% macro building_modular_station_catenaryC(orientation) -%}
	{{ layouts.building_auto_orient(orientation, "CUSTOM(0, spr_building_catenary + LOAD_TEMP(9))",
		16, 6, 10,  0,  4,  2, hide_sprite = "LOAD_TEMP(8)") }}
{%- endmacro %}

{% macro building_modular_station_overpass_low(x) -%}
	{{ building_modular_station_overpass(x, 0, 26) }}
{%- endmacro %}

{% macro building_modular_station_overpass_high(x) -%}
	{{ building_modular_station_overpass(x, 2, 50) }}
{%- endmacro %}


{% macro layout_high_platformA_modular_low(x) -%}
	{{ platforms.building_high_platformA(x, roof = True) }}
	{{ building_modular_station_pole(x, 0, 3) }}
	{{ building_modular_station_pole(x, 1, 0) }}
	{{ building_modular_station_overpass_low(x) }}
	{{ building_modular_station_catenaryA(x) }}
{%- endmacro %}

{% macro layout_high_platformB_modular_low(x) -%}
	{{ platforms.building_high_platformB(x, roof = True) }}
	{{ building_modular_station_pole(x, 0, 0) }}
	{{ building_modular_station_pole(x, 1, 3) }}
	{{ building_modular_station_overpass_low(x) }}
	{{ building_modular_station_catenaryB(x) }}
{%- endmacro %}

{% macro layout_high_platformC_modular_low(x) -%}
	{{ platforms.building_high_platformA(x, roof = True) }}
	{{ platforms.building_high_platformB(x, roof = True) }}
