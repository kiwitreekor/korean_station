{%- set ORIENTATION_X = 0 -%}
{%- set ORIENTATION_Y = 1 -%}

{% macro sprite_auto_orient(orientation, original) -%}
    {%- set open_paren = original.find('(') -%}
    {%- set close_paren = original.rfind(')') -%}

    {%- if open_paren != -1 and close_paren != -1 and close_paren > open_paren and orientation == ORIENTATION_Y -%}
        {%- set num_str = original[open_paren + 1 : close_paren] -%}
        {{ original[:open_paren+1] }}{{ num_str + " + 1" }}{{ original[close_paren:] }}
    {%- else -%}
        {{ original }}
    {%- endif -%}
{%- endmacro %}

{% macro building_auto_orient(orientation, sprite, xoffs, yoffs, zoffs, xext, yext, zext, always_draw = 0, hide_sprite = 0, palette = "", sprite_offset = True) -%}
	building {
	{%- if sprite_offset %}
		sprite: {{ sprite_auto_orient(orientation, sprite) }};
	{%- else %}
		sprite: {{ sprite }};
	{%- endif %}
		always_draw: {{ always_draw }};
		hide_sprite: {{ hide_sprite }};
	{%- if orientation == ORIENTATION_X %}
		xoffset: {{ xoffs }};
		yoffset: {{ yoffs }};
		xextent: {{ xext }};
		yextent: {{ yext }};
	{%- else %}
		xoffset: {{ yoffs }};
		yoffset: {{ xoffs }};
		xextent: {{ yext }};
		yextent: {{ xext }};
	{%- endif %}
		zoffset: {{ zoffs }};
		zextent: {{ zext }};
		
	{%- if palette != "" %}
		recolour_mode: RECOLOUR_REMAP;
		palette: {{ palette }};
	{%- endif %}
	}
{%- endmacro %}

{% macro childsprite(orientation, sprite, xoffs = 0, yoffs = 0, always_draw = 0, hide_sprite = 0) -%}
	childsprite {
		sprite: {{ sprite_auto_orient(orientation, sprite) }};
		xoffset: {{ xoffs }};
		yoffset: {{ yoffs }};
		hide_sprite: {{ hide_sprite }};
	}
{%- endmacro %}

{% macro layout_auto_orient(buildings, custom_ground = "", auto_orient = True) -%}
spritelayout {{ buildings.name + "_X" }} {
	ground {
		{% if custom_ground == "" -%}
			sprite: GROUNDSPRITE_RAIL_X;
		{%- else -%}
			sprite: {{ sprite_auto_orient(ORIENTATION_X, custom_ground) }};
		{%- endif %}
	}
	{{ buildings(ORIENTATION_X) }}
}

spritelayout {{ buildings.name + "_Y" }} {
	ground {
		{% if custom_ground == "" -%}
			sprite: GROUNDSPRITE_RAIL_Y;
		{%- else -%}
			sprite: {{ sprite_auto_orient(ORIENTATION_Y, custom_ground) }};
		{%- endif %}
	}
	{{ buildings(ORIENTATION_Y) }}
}
{%- endmacro %}