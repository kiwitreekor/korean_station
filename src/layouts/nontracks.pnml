{% import 'layouts/layouts.pnml' as layouts %}
{% import 'layouts/platforms.pnml' as platforms %}

// platform buildings
{% macro building_platform_nontrack(orientation, offset, h, roof = False) -%}
{% if roof -%}
	{{ layouts.building_auto_orient(orientation, "DEFAULT(spr_platform_shadow + {})".format(offset),
		0,  0,  0, 16,  6,  h, always_draw = 1) }}
{%- else -%}
	{{ layouts.building_auto_orient(orientation, "DEFAULT(spr_platform_normal + {} + LOAD_TEMP(2) * spr_platform_snow_offset)".format(offset),
		0,  0,  0, 16,  6,  h, always_draw = 1) }}
{%- endif %}
	{{ layouts.building_auto_orient(orientation, "DEFAULT(spr_passengers + LOAD_TEMP(1))",
		0,  0,  h, 16,  6,  5, hide_sprite = "LOAD_TEMP(0)") }}
	{{ layouts.building_auto_orient(orientation, "DEFAULT(spr_passengers + 2 + LOAD_TEMP(1))",
		0, 10,  h, 16,  6,  5, hide_sprite = "LOAD_TEMP(0)") }}
{%- endmacro %}

{% macro building_platform_nontrack_roofA(orientation, h) -%}
	{{ layouts.building_auto_orient(orientation, "CUSTOM(0, spr_roof_pole)",
		0,  0,      h, 16,  0, 10) }}
	{{ layouts.building_auto_orient(orientation, "CUSTOM(0, spr_roof_pole + 2)",
		0, 16,      h, 16,  0, 10) }}
	{{ layouts.building_auto_orient(orientation, "CUSTOM(0, spr_roofA + 4)",
		0,  0, 10 + h, 16, 16,  3, palette = "PALETTE_CC_DARK_BLUE + LOAD_TEMP(3)") }}
	{{ layouts.childsprite(orientation, "CUSTOM(0, spr_roofA + 4 + spr_roof_snow)", hide_sprite = "!LOAD_TEMP(2)") }}
{%- endmacro %}

{% macro building_platform_nontrack_roofB(orientation, h) -%}
	{{ layouts.building_auto_orient(orientation, "CUSTOM(0, spr_roof_pole + 4)",
		0,  4,      h, 16,  0, 10) }}
	{{ layouts.building_auto_orient(orientation, "CUSTOM(0, spr_roof_pole + 6)",
		0, 12,      h, 16,  0, 10) }}
	{{ layouts.building_auto_orient(orientation, "CUSTOM(0, spr_roofB + 4)",
		0,  0, 10 + h, 16,  6,  3, palette = "PALETTE_CC_DARK_BLUE + LOAD_TEMP(3)") }}
	{{          layouts.childsprite(orientation, "CUSTOM(0, spr_roofB + 4 + spr_roof_snow)", hide_sprite = "!LOAD_TEMP(2)") }}
{%- endmacro %}

{% macro building_high_platform_nontrack(x, roof = False) -%}
	{{ building_platform_nontrack(x, 12, 3, roof = roof) }}
{%- endmacro %}

{% macro building_low_platform_nontrack(x, roof = False) -%}
	{{ building_platform_nontrack(x, 14, 1, roof = roof) }}
{%- endmacro %}

{% macro building_low_asphalt_platform_nontrack(x, roof = False) -%}
	{{ building_platform_nontrack(x, 16, 1, roof = roof) }}
{%- endmacro %}


{% macro layout_high_platform_nontrack(x) -%}
	{{ building_high_platform_nontrack(x) }}
{%- endmacro %}

{% macro layout_low_platform_nontrack(x) -%}
	{{ building_low_platform_nontrack(x) }}
{%- endmacro %}

{% macro layout_low_asphalt_platform_nontrack(x) -%}
	{{ building_low_asphalt_platform_nontrack(x) }}
{%- endmacro %}

{% macro layout_high_platform_nontrack_roofA(x) -%}
	{{ building_high_platform_nontrack(x, roof = True) }}
	{{ building_platform_nontrack_roofA(x, 3) }}
{%- endmacro %}

{% macro layout_low_platform_nontrack_roofA(x) -%}
	{{ building_low_platform_nontrack(x, roof = True) }}
	{{ building_platform_nontrack_roofA(x, 1) }}
{%- endmacro %}

{% macro layout_low_asphalt_platform_nontrack_roofA(x) -%}
	{{ building_low_asphalt_platform_nontrack(x, roof = True) }}
	{{ building_platform_nontrack_roofA(x, 1) }}
{%- endmacro %}

{% macro layout_high_platform_nontrack_roofB(x) -%}
	{{ building_high_platform_nontrack(x, roof = True) }}
	{{ building_platform_nontrack_roofB(x, 3) }}
{%- endmacro %}

{% macro layout_low_platform_nontrack_roofB(x) -%}
	{{ building_low_platform_nontrack(x, roof = True) }}
	{{ building_platform_nontrack_roofB(x, 1) }}
{%- endmacro %}

{% macro layout_low_asphalt_platform_nontrack_roofB(x) -%}
	{{ building_low_asphalt_platform_nontrack(x, roof = True) }}
	{{ building_platform_nontrack_roofB(x, 1) }}
{%- endmacro %}

{{ layouts.layout_auto_orient("layout_high_platform_nontrack", layout_high_platform_nontrack) }}
{{ layouts.layout_auto_orient("layout_low_platform_nontrack", layout_low_platform_nontrack) }}
{{ layouts.layout_auto_orient("layout_low_asphalt_platform_nontrack", layout_low_asphalt_platform_nontrack) }}

{{ layouts.layout_auto_orient("layout_high_platform_nontrack_roofA", layout_high_platform_nontrack_roofA) }}
{{ layouts.layout_auto_orient("layout_low_platform_nontrack_roofA", layout_low_platform_nontrack_roofA) }}
{{ layouts.layout_auto_orient("layout_low_asphalt_platform_nontrack_roofA", layout_low_asphalt_platform_nontrack_roofA) }}

{{ layouts.layout_auto_orient("layout_high_platform_nontrack_roofB", layout_high_platform_nontrack_roofB) }}
{{ layouts.layout_auto_orient("layout_low_platform_nontrack_roofB", layout_low_platform_nontrack_roofB) }}
{{ layouts.layout_auto_orient("layout_low_asphalt_platform_nontrack_roofB", layout_low_asphalt_platform_nontrack_roofB) }}