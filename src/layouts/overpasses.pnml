{% import 'layouts/layouts.pnml' as layouts %}
{% import 'layouts/platforms.pnml' as platforms %}

{% macro overpass_sprite_offset(h) -%}
    {%- if h == 3 -%}
        {{ 0 }}
    {%- else -%}
        {{ 12 }}
    {%- endif -%}
{%- endmacro %}

{% macro building_platformA_overpass(orientation, h) -%}
	{{ layouts.building_auto_orient(orientation, "DEFAULT(spr_overpass + {} + LOAD_TEMP(4))".format(overpass_sprite_offset(h) | int),
		0,  0,  h, 16,  3, 22-h) }}
	{{ layouts.building_auto_orient(orientation, "DEFAULT(spr_overpass + {} + LOAD_TEMP(4))".format(overpass_sprite_offset(h) | int + 6),
		7,  0, 14,  3, 16,  8) }}
{%- endmacro %}

{% macro building_platformB_overpass(orientation, h) -%}
	{{ layouts.building_auto_orient(orientation, "DEFAULT(spr_overpass + {} + LOAD_TEMP(4))".format(overpass_sprite_offset(h) | int + 8),
		7,  0, 14,  3, 10,  8) }}
	{{ layouts.building_auto_orient(orientation, "DEFAULT(spr_overpass + {} + LOAD_TEMP(4))".format(overpass_sprite_offset(h) | int + 2),
		0, 13,  h, 16,  3, 22-h) }}
{%- endmacro %}

{% macro building_platformC_overpass(orientation, h) -%}
	{{ layouts.building_auto_orient(orientation, "DEFAULT(spr_overpass + {} + LOAD_TEMP(4))".format(overpass_sprite_offset(h) | int),
		0,  0,  h, 16,  3, 22-h) }}
	{{ layouts.building_auto_orient(orientation, "DEFAULT(spr_overpass + {} + LOAD_TEMP(4))".format(overpass_sprite_offset(h) | int + 10),
		7,  0, 14,  3, 10,  8) }}
	{{ layouts.building_auto_orient(orientation, "DEFAULT(spr_overpass + {} + LOAD_TEMP(4))".format(overpass_sprite_offset(h) | int + 2),
		0, 13,  h, 16,  3, 22-h) }}
{%- endmacro %}

{% macro building_track_overpass(orientation, h) -%}
	{{ layouts.building_auto_orient(orientation, "DEFAULT(spr_overpass + {} + LOAD_TEMP(4))".format(overpass_sprite_offset(h) | int + 4),
		7,  0, 14,  3, 16,  8) }}
{%- endmacro %}

{% macro building_platformA_overpass_guide(orientation, h, roof = False) -%}
	{{ layouts.building_auto_orient(orientation, "DEFAULT(spr_overpass_guide + LOAD_TEMP(5))",
		0,  0,  h, 16,  6,  0) }}
{%- endmacro %}

{% macro building_platformB_overpass_guide(orientation, h, roof = False) -%}
	{{ layouts.building_auto_orient(orientation, "DEFAULT(spr_overpass_guide + 4 + LOAD_TEMP(5))",
		0, 10,  h, 16,  6,  0) }}
{%- endmacro %}

// layouts

{% macro layout_high_platformA_overpass(x) -%}
	{{ platforms.building_high_platformA(x) }}
	{{ building_platformA_overpass(x, 3) }}
{%- endmacro %}

{% macro layout_high_platformB_overpass(x) -%}
	{{ platforms.building_high_platformB(x) }}
	{{ building_platformB_overpass(x, 3) }}
{%- endmacro %}

