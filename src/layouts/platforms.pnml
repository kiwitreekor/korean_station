{% import 'layouts/layouts.pnml' as layouts %}

// platform buildings
{% macro building_platformA(orientation, offset, h, roof = False) -%}
{% if roof -%}
	{{ layouts.building_auto_orient(orientation, "DEFAULT(spr_platform_shadow + {})".format(offset),
		0,  0,  0, 16,  6,  h, always_draw = 1) }}
{%- else -%}
	{{ layouts.building_auto_orient(orientation, "DEFAULT(spr_platform_normal + {} + LOAD_TEMP(2) * spr_platform_snow_offset)".format(offset),
		0,  0,  0, 16,  6,  h, always_draw = 1) }}
{%- endif %}
	{{ layouts.building_auto_orient(orientation, "DEFAULT(spr_passengers + LOAD_TEMP(1))",
		0,  0,  h, 16,  6,  5, hide_sprite = "LOAD_TEMP(0)") }}
{%- endmacro %}

{% macro building_platformA_roofA(orientation, h) -%}
	{{ layouts.building_auto_orient(orientation, "CUSTOM(0, spr_roof_pole)",
		0,  0,      h, 16,  0, 10) }}
	{{ layouts.building_auto_orient(orientation, "CUSTOM(0, spr_roofA)",
		0,  0, 10 + h, 16,  6,  3, palette = "PALETTE_CC_DARK_BLUE + LOAD_TEMP(3)") }}
	{{ layouts.childsprite(orientation, "CUSTOM(0, spr_roofA + spr_roof_snow)", hide_sprite = "!LOAD_TEMP(2)") }}
{%- endmacro %}

{% macro building_platformA_roofB(orientation, h) -%}
	{{ layouts.building_auto_orient(orientation, "CUSTOM(0, spr_roof_pole + 4)",
		0,  3,      h, 16,  0, 10) }}
	{{ layouts.building_auto_orient(orientation, "CUSTOM(0, spr_roofB)",
		0,  0, 10 + h, 16,  6,  3, palette = "PALETTE_CC_DARK_BLUE + LOAD_TEMP(3)") }}
	{{          layouts.childsprite(orientation, "CUSTOM(0, spr_roofB + spr_roof_snow)", hide_sprite = "!LOAD_TEMP(2)") }}
{%- endmacro %}

{% macro building_platformB(orientation, offset, h, roof = False) -%}
{% if roof -%}
	{{ layouts.building_auto_orient(orientation, "DEFAULT(spr_platform_shadow + {} + 2)".format(offset),
		0, 10,  0, 16,  6,  h, always_draw = 1) }}
{%- else -%}
	{{ layouts.building_auto_orient(orientation, "DEFAULT(spr_platform_normal + {} + 2 + LOAD_TEMP(2) * spr_platform_snow_offset)".format(offset),
		0, 10,  0, 16,  6,  h, always_draw = 1) }}
{%- endif %}
	{{ layouts.building_auto_orient(orientation, "DEFAULT(spr_passengers + 2 + LOAD_TEMP(1))",
		0, 10,  h, 16,  6,  5, hide_sprite = "LOAD_TEMP(0)") }}
{%- endmacro %}

{% macro building_platformB_roofA(orientation, h) -%}
	{{ layouts.building_auto_orient(orientation, "CUSTOM(0, spr_roof_pole + 2)",
		0, 10,      h, 16,  0, 10) }}
	{{ layouts.building_auto_orient(orientation, "CUSTOM(0, spr_roofA + 2)",
		0, 10, 10 + h, 16,  6,  3, palette = "PALETTE_CC_DARK_BLUE + LOAD_TEMP(3)") }}
	{{          layouts.childsprite(orientation, "CUSTOM(0, spr_roofA + 2 + spr_roof_snow)", hide_sprite = "!LOAD_TEMP(2)") }}
{%- endmacro %}

{% macro building_platformB_roofB(orientation, h) -%}
	{{ layouts.building_auto_orient(orientation, "CUSTOM(0, spr_roof_pole + 4)",
		0, 13,      h, 16,  0, 10) }}
	{{ layouts.building_auto_orient(orientation, "CUSTOM(0, spr_roofB + 2)",
		0, 10, 10 + h, 16,  6,  3, palette = "PALETTE_CC_DARK_BLUE + LOAD_TEMP(3)") }}
	{{          layouts.childsprite(orientation, "CUSTOM(0, spr_roofB + 2 + spr_roof_snow)", hide_sprite = "!LOAD_TEMP(2)") }}
{%- endmacro %}

{% macro building_high_platformA(x, roof = False) -%}
	{{ building_platformA(x, 0, 3, roof = roof) }}
{%- endmacro %}

{% macro building_high_platformB(x, roof = False) -%}
	{{ building_platformB(x, 0, 3, roof = roof) }}
{%- endmacro %}

{% macro building_low_platformA(x, roof = False) -%}
	{{ building_platformA(x, 4, 3, roof = roof) }}
{%- endmacro %}

{% macro building_low_platformB(x, roof = False) -%}
	{{ building_platformB(x, 4, 3, roof = roof) }}
{%- endmacro %}

{% macro building_low_asphalt_platformA(x, roof = False) -%}
	{{ building_platformA(x, 8, 3, roof = roof) }}
{%- endmacro %}

{% macro building_low_asphalt_platformB(x, roof = False) -%}
	{{ building_platformB(x, 8, 3, roof = roof) }}
{%- endmacro %}

