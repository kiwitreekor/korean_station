{%include 'layouts/nontracks.pnml' %}

item(FEAT_STATIONS, item_high_platform_nontrack, 0x52) {
	property {
		class: "KWS5";
		name: string(STR_STATION_HP_NONTRACK);
		classname: string(STR_STATION_CLASS_NONTRACK);
        hide_wire_tiles: STAT_ALL_TILES;
        non_traversable_tiles: STAT_ALL_TILES;
	}
	graphics {
		default: sprgroup_platform;
		purchase: sprgroup_platform;
		sprite_layouts: [layout_high_platform_nontrack_X, layout_high_platform_nontrack_Y];
		prepare_layout: sw_prepare_platform();
	}
}

