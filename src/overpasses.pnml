{%include 'layouts/overpasses.pnml' %}

switch(FEAT_STATIONS, SELF, sw_overpass_layout_from_end, platform_position_from_end(PLATFORM_SAME_SECTION)) {
    0: return 2;
    return 0;
}

switch(FEAT_STATIONS, SELF, sw_overpass_layout_from_start, platform_position_from_start(PLATFORM_SAME_SECTION)) {
    0: return 2;
    sw_overpass_layout_from_end;
}

switch(FEAT_STATIONS, SELF, sw_overpass_layout, platform_length(PLATFORM_SAME_SECTION)) {
    1: return 0;
    sw_overpass_layout_from_start;
}

switch(FEAT_STATIONS, SELF, sw_overpass_guide_offset, platform_position_from_start(PLATFORM_SAME_SECTION)) {
    0: return 2;
    return 0;
}

switch(FEAT_STATIONS, SELF, sw_prepare_overpass, [
	STORE_TEMP(sw_terrain_snow() * spr_overpass_snow_offset, 4), 
	STORE_TEMP(sw_overpass_guide_offset(), 5), 
]) {
	sw_prepare_platform;
}

switch(FEAT_STATIONS, SELF, sw_purchase_prepare_overpass, [
	STORE_TEMP(sw_terrain_snow() * spr_overpass_snow_offset, 4), 
	STORE_TEMP(sw_overpass_guide_offset(), 5), 
]) {
	sw_prepare_platform;
}

item(FEAT_STATIONS, item_high_platformA_overpass, 0x5B) {
	property {
		class: "KWS0";
		name: string(STR_STATION_OVERPASS_HP_A);
		cargo_random_triggers: [PASS];
        disabled_length: bitmask(4, 5, 6, 7, 8);
	}
	graphics {
		default: sprgroup_platform;
		purchase: sprgroup_platform;
		sprite_layouts: [
            layout_high_platformA_overpass_X, 
            layout_high_platformA_overpass_Y,
            layout_high_platformA_overpass_guide_X, 
            layout_high_platformA_overpass_guide_Y,
        ];
        select_sprite_layout: sw_overpass_layout();
		prepare_layout: sw_prepare_overpass();
	}
}

