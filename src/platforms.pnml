{%include 'layouts/platforms.pnml' %}

item(FEAT_STATIONS, item_high_platformA, 0x00) {
	property {
		class: "KWS0";
		name: string(STR_STATION_HP_A);
		classname: string(STR_STATION_CLASS_PLATFORM);
		cargo_random_triggers: [PASS];
	}
	graphics {
		default: sprgroup_platform;
		purchase: sprgroup_platform;
		sprite_layouts: [layout_high_platformA_X, layout_high_platformA_Y];
		prepare_layout: sw_prepare_platform();
	}
}

