{%include 'layouts/platforms.pnml' %}

{% macro item_platform_properties(x, string_code, custom_spritesets = "") -%}
	property {
		class: "KWS0";
		name: string({{ string_code }});
		classname: string(STR_STATION_CLASS_PLATFORM);
		cargo_random_triggers: [PASS];
	}
	graphics {
        default: sprgroup_platform;
        purchase: sprgroup_platform;
        sprite_layouts: [
            layout_{{ x }}_X, 
            layout_{{ x }}_Y,
        ];
        {% if custom_spritesets -%}
            custom_spritesets: {{ custom_spritesets }};
        {%- endif %}
		prepare_layout: sw_prepare_platform();
	}
{%- endmacro %}

item(FEAT_STATIONS, item_high_platformA, 0x00) {
	{{ item_platform_properties("high_platformA", "STR_STATION_HP_A") }}
}

item(FEAT_STATIONS, item_high_platformB, 0x01) {
	{{ item_platform_properties("high_platformB", "STR_STATION_HP_B") }}
}

