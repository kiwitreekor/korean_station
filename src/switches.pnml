
// switches
const bitmask_station_triggers = bitmask(TRIGGER_STATION_NEW_CARGO, TRIGGER_STATION_TRAIN_ARRIVES, TRIGGER_STATION_TRAIN_LEAVES, TRIGGER_STATION_TRAIN_LOADS_UNLOADS);

random_switch(FEAT_STATIONS, TILE, sw_platform_passengers_hide_1, bitmask_station_triggers) {
	7: return 1;
	1: return 0;
}

random_switch(FEAT_STATIONS, TILE, sw_platform_passengers_hide_8, bitmask_station_triggers) {
	3: return 1;
	1: return 0;
}

random_switch(FEAT_STATIONS, TILE, sw_platform_passengers_hide_16, bitmask_station_triggers) {
	1: return 1;
	1: return 0;
}

random_switch(FEAT_STATIONS, TILE, sw_platform_passengers_hide_32, bitmask_station_triggers) {
	1: return 1;
	3: return 0;
}

switch(FEAT_STATIONS, SELF, sw_platform_passengers_hide_amount, cargo_amount_waiting(PASS)) {
	0: return 1;
	1 .. 7: sw_platform_passengers_hide_1;
	8 .. 15: sw_platform_passengers_hide_8;
	16 .. 31: sw_platform_passengers_hide_16;
	32 .. 63: sw_platform_passengers_hide_32;
	return 0;
}

switch(FEAT_STATIONS, SELF, sw_platform_passengers_hide, param_flags_passenger) {
	1: sw_platform_passengers_hide_amount;
	return 1;
}

random_switch(FEAT_STATIONS, TILE, sw_platform_passengers_32, bitmask_station_triggers) {
	3: return 0;
	1: return 4;
}

random_switch(FEAT_STATIONS, TILE, sw_platform_passengers_64, bitmask_station_triggers) {
	1: return 0;
	1: return 4;
}

random_switch(FEAT_STATIONS, TILE, sw_platform_passengers_128, bitmask_station_triggers) {
	1: return 0;
	2: return 4;
	1: return 8;
}

random_switch(FEAT_STATIONS, TILE, sw_platform_passengers_256, bitmask_station_triggers) {
	1: return 4;
	1: return 8;
}

random_switch(FEAT_STATIONS, TILE, sw_platform_passengers_512, bitmask_station_triggers) {
	1: return 4;
	2: return 8;
	1: return 12;
}

random_switch(FEAT_STATIONS, TILE, sw_platform_passengers_768, bitmask_station_triggers) {
	1: return 8;
	1: return 12;
}

random_switch(FEAT_STATIONS, TILE, sw_platform_passengers_1024, bitmask_station_triggers) {
	2: return 8;
	4: return 12;
	1: return 16;
	1: return 20;
}

random_switch(FEAT_STATIONS, TILE, sw_platform_passengers_2048, bitmask_station_triggers) {
	2: return 12;
	1: return 16;
	1: return 20;
}

random_switch(FEAT_STATIONS, TILE, sw_platform_passengers_4096, bitmask_station_triggers) {
	1: return 16;
	1: return 20;
}

switch(FEAT_STATIONS, SELF, sw_platform_passengers, cargo_amount_waiting(PASS)) {
	0 .. 31: return 0;
	32 .. 63: sw_platform_passengers_32;
	64 .. 127: sw_platform_passengers_64;
	128 .. 255: sw_platform_passengers_128;
	256 .. 511: sw_platform_passengers_256;
	512 .. 767: sw_platform_passengers_512;
	768 .. 1023: sw_platform_passengers_768;
	1024 .. 2047: sw_platform_passengers_1024;
	2048 .. 4095: sw_platform_passengers_2048;
	sw_platform_passengers_4096;
}

switch(FEAT_STATIONS, SELF, sw_terrain_snow, terrain_type) {
	TILETYPE_SNOW: return 1;
	return 0;
}

switch(FEAT_STATIONS, SELF, sw_company_color, company_colour1) {
	return;
}

switch(FEAT_STATIONS, SELF, sw_roof_color_custom, param_flags_roof_color - 1) {
	return;
}

switch(FEAT_STATIONS, SELF, sw_roof_color, param_flags_roof_color) {
	0: sw_company_color;
	return sw_roof_color_custom;
}

switch(FEAT_STATIONS, SELF, sw_prepare_platform, [
	STORE_TEMP(sw_platform_passengers_hide(), 0), 
	STORE_TEMP(sw_platform_passengers(), 1),
	STORE_TEMP(sw_terrain_snow(), 2),
	STORE_TEMP(sw_roof_color(), 3),
]) {
	CB_FAILED;
}

switch(FEAT_STATIONS, SELF, sw_building_nearby_info_parallel, nearby_tile_perpendicular(LOAD_TEMP(126), LOAD_TEMP(127))) {
    1: return 2;
    return 1;
}

switch(FEAT_STATIONS, SELF, sw_building_nearby_info, nearby_tile_station_id(LOAD_TEMP(126), LOAD_TEMP(127))) {
    0x2E .. 0x2F: sw_building_nearby_info_parallel;
    return 0;
}