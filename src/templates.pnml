

// templates
template tmpl_platform_base(x, y, h) {
	[x,     y, 44, 21+h, -31, -h]
	[x+50,  y, 44, 21+h, -11, -h]
	[x+100, y, 44, 21+h, -31, -h]
	[x+150, y, 44, 21+h, -11, -h]
}
	
template tmpl_platform_nontrack_base(x, y, h) {
	[x,    y, 64, 31+h, -31, -h]
	[x+70, y, 64, 31+h, -31, -h]
}

template tmpl_platform_high(x, y) {
	tmpl_platform_base(x, y, 3)
}

template tmpl_platform_low(x, y) {
	tmpl_platform_base(x, y, 1)
}

template tmpl_platform(x, y) {
	tmpl_platform_high(x, y)
	tmpl_platform_low(x, y+40)
	tmpl_platform_low(x, y+80)
}

template tmpl_platform_high_crossings(x, y) {
	tmpl_platform_high(x, y)
	tmpl_platform_high(x, y+40)
	tmpl_platform_high(x, y+80)
}

template tmpl_platform_low_crossings(x, y) {
	tmpl_platform_low(x, y)
	tmpl_platform_low(x, y+40)
	tmpl_platform_low(x, y+80)
}
	
template tmpl_crossing_track(x, y) {
	[x,    y, 38, 18,  -5, 0]
	[x+50, y, 38, 18, -31, 0]
}

template tmpl_platform_nontrack_high(x, y) {
	tmpl_platform_nontrack_base(x, y, 3)
}

template tmpl_platform_nontrack_low(x, y) {
	tmpl_platform_nontrack_base(x, y, 1)
}

template tmpl_platform_nontrack(x, y) {
	tmpl_platform_nontrack_high(x, y)
	tmpl_platform_nontrack_low(x, y+40)
	tmpl_platform_nontrack_low(x, y+80)
}

template tmpl_platform_passengers(x, y) {
	[x,     y, 44, 23, -31, -4]
	[x+50,  y, 44, 23, -11, -4]
	[x+100, y, 44, 23, -31, -4]
	[x+150, y, 44, 23, -11, -4]
}

