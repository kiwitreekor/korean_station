	tmpl_building_high(x,     y+180)
	tmpl_building_high(x+160, y+180)
}

template tmpl_building_catenary(x, y) {
	[x,    y,  8,  8,  3, -1]
	[x+20, y,  8,  8,  3, -1]
	[x+40, y,  9,  9, -1, -5]
	[x+60, y,  9,  9, -7, -5]
}

template tmpl_building_pole(x, y, h) {
	[x,    y, 32, 27-h, -31, -12+h]
	[x+80, y, 32, 27-h,   1, -12+h]
}

template tmpl_building_ground(x, y) {
	[x,    y, 64, 31, -31, 0]
	[x,    y, 64, 31, -31, 0]
}

template tmpl_building_ground_snow(x, y) {
	[x,    y,     64, 31, -31, 0]
	[x+80, y,     64, 31, -31, 0]
	[x,    y+40,  64, 31, -31, 0]
	[x+80, y+40,  64, 31, -31, 0]
	[x,    y+80,  64, 31, -31, 0]
	[x+80, y+80,  64, 31, -31, 0]
	[x,    y+120, 64, 31, -31, 0]
	[x+80, y+120, 64, 31, -31, 0]
	[x,    y+160, 64, 31, -31, 0]
	[x+80, y+160, 64, 31, -31, 0]
	[x,    y+200, 64, 31, -31, 0]
	[x+80, y+200, 64, 31, -31, 0]
}