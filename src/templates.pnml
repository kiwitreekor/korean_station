template tmpl_building_low_4(x, y) {
	tmpl_building_low(x,     y)
	tmpl_building_low(x+160, y)
}

template tmpl_building_low_corner(x, y) {
	tmpl_building_low(x,     y)
	tmpl_building_low(x+160, y)
	tmpl_building_low(x,     y+180)
	tmpl_building_low(x+160, y+180)
}

template tmpl_building_high_4(x, y) {
	tmpl_building_high(x,     y)
	tmpl_building_high(x+160, y)
